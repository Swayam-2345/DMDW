import pandas as pd
from mlxtend.preprocessing import TransactionEncoder
from mlxtend.frequent_patterns import apriori, association_rules

# -----------------------------------------
# Step 1: Load the dataset
# -----------------------------------------

data = pd.read_csv("/content/groceries - groceries.csv")

print("Dataset:")
print(data.head())

# -----------------------------------------
# Step 2: Convert dataset into transactions
# -----------------------------------------

transactions = []

for i in range(len(data)):
    transaction = []

    for item in data.iloc[i]:
        if pd.notna(item):
            transaction.append(str(item).strip())

    transactions.append(transaction)

# -----------------------------------------
# Step 3: One-hot encode the transactions
# -----------------------------------------

te = TransactionEncoder()

encoded_data = te.fit(transactions).transform(transactions)

basket = pd.DataFrame(
    encoded_data,
    columns=te.columns_
)

print("\nEncoded Dataset:")
print(basket.head())

# -----------------------------------------
# Step 4: Apply Apriori algorithm
# -----------------------------------------

frequent_itemsets = apriori(
    basket,
    min_support=0.01,
    use_colnames=True
)

print("\nFrequent Itemsets:")
print(frequent_itemsets.head(20))

# -----------------------------------------
# Step 5: Generate Association Rules
# -----------------------------------------

rules = association_rules(
    frequent_itemsets,
    metric="confidence",
    min_threshold=0.2
)

# -----------------------------------------
# Step 6: Display important columns
# -----------------------------------------

rules = rules[
    [
        "antecedents",
        "consequents",
        "support",
        "confidence",
        "lift"
    ]
]

# Sort according to confidence
rules = rules.sort_values(
    by="confidence",
    ascending=False
)

print("\nAssociation Rules:")
print(rules.head(20).to_string(index=False))

